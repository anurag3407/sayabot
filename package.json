{
  "name": "sayabot",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sayabot/db generate",
    "db:migrate": "pnpm --filter @sayabot/db migrate",
    "db:seed": "pnpm --filter @sayabot/db seed",
    "format": "prettier --write .",
    "mobile:dev": "turbo run dev --filter=@sayabot/mobile",
    "mobile:typecheck": "turbo run typecheck --filter=@sayabot/mobile",
    "mobile:update": "pnpm --filter @sayabot/mobile update:ota",
    "mobile:build:apk": "pnpm --filter @sayabot/mobile build:apk",
    "desktop:build": "pnpm --filter @sayabot/desktop build",
    "desktop:dev": "pnpm --filter @sayabot/desktop dev",
    "desktop:package:dmg": "pnpm --filter @sayabot/desktop package:dmg",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:unit": "turbo run test --filter=@sayabot/core --filter=@sayabot/llm --filter=@sayabot/orchestrator --filter=@sayabot/web --filter=@sayabot/egress --filter=@sayabot/computerd --filter=@sayabot/mobile",
    "test:integration": "node tests/integration/run.mjs",
    "test:e2e:api": "E2E_SMOKE=1 playwright test api navigation.spec.ts api-guard.spec.ts",
    "test:e2e": "playwright test",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "getenv": "^2.0.0"
  }
}
