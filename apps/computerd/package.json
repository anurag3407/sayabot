{
  "name": "@sayabot/computerd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "typecheck": "tsc",
    "lint": "eslint src agentd",
    "test": "vitest run",
    "build:agentd": "esbuild agentd/agentd.ts agentd/agentd-cli.ts --bundle --platform=node --target=node22 --format=esm --external:typescript --outdir=dist/agentd --out-extension:.js=.mjs --log-level=warning"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@sayabot/core": "workspace:*",
    "dotenv-cli": "^11.1.0",
    "hono": "^4.13.14",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "zod": "^4.6.7",
    "e2b": "^2.62.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5",
    "esbuild": "0.28.2"
  }
}
