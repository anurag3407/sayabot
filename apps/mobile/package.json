{
  "name": "@sayabot/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update:ota": "eas update --auto --branch production",
    "build:apk": "eas build -p android --profile preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsc --noEmit -p tests/unit/tsconfig.json && node --no-warnings --experimental-strip-types tests/unit/env.test.ts && node --no-warnings --experimental-strip-types tests/unit/workspace-draft.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sayabot/core": "workspace:*",
    "@supabase/supabase-js": "^2.48.0",
    "expo": "~52.0.0",
    "expo-clipboard": "~7.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "^0.27.5",
    "lucide-react-native": "^0.475.0",
    "react": "^19.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
