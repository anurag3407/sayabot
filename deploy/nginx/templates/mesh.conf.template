# Rendered by the nginx image entrypoint: ${MESH_DOMAIN} is substituted at container
# start. Plain nginx variables ($host, $remote_addr...) are left untouched.

upstream mesh_web {
    zone mesh_web 64k;
    server web:3000;
    keepalive 32;
}

upstream mesh_orchestrator {
    zone mesh_orchestrator 64k;
    server orchestrator:4000;
    keepalive 8;
}

# ── :80 — ACME challenges, everything else goes to HTTPS ─────────────────
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://${MESH_DOMAIN}$request_uri;
    }
}

# ── :443 — reject unknown Host headers (IP scans, spoofed hosts) ─────────
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    ssl_certificate     /etc/letsencrypt/live/${MESH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MESH_DOMAIN}/privkey.pem;
    return 444;
}

# ── :443 — Mesh ──────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${MESH_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MESH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MESH_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/security-headers.conf;

    limit_conn mesh_conn 100;

    include /etc/nginx/snippets/mesh-locations.conf;
}
