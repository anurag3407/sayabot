# Rendered by the nginx image entrypoint: ${MESH_DOMAIN} is substituted at container
# start. Plain nginx variables ($host, $remote_addr...) are left untouched.

upstream mesh_web {
    zone mesh_web 64k;
    server web:3000;
    keepalive 32;
}

upstream mesh_orchestrator {
    zone mesh_orchestrator 64k;
    server orchestrator:4000;
    keepalive 8;
}

# ── :80 — ACME challenges, everything else goes to HTTPS ─────────────────
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://${MESH_DOMAIN}$request_uri;
    }
}

# ── :443 — reject unknown Host headers (IP scans, spoofed hosts) ─────────
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    ssl_certificate     /etc/letsencrypt/live/${MESH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MESH_DOMAIN}/privkey.pem;
    return 444;
}

# ── :443 — Mesh ──────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${MESH_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MESH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MESH_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/security-headers.conf;

    limit_conn mesh_conn 100;

    # Canvas sync (Hocuspocus). Long-lived WebSocket straight to the orchestrator.
    # This is the only orchestrator path exposed; /internal/* stays private.
    location = /collab {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_orchestrator;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Bot API + MCP connector (proxied by Next to the orchestrator). Streams NDJSON/SSE,
    # so no buffering in either direction; the route allows up to 300s.
    location ~ ^/(api/v1|mcp)/ {
        limit_req zone=mesh_api burst=60 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_web;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
        add_header X-Accel-Buffering no;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Liveness for uptime monitors. Not logged, not rate limited.
    location = /api/health {
        access_log off;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_web;
    }

    # Credential endpoints: slow down password guessing and code brute force.
    location ~ ^/(login|signup|forgot-password|reset-password|auth)(/|$) {
        limit_req zone=mesh_auth burst=20 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_web;
    }

    # Content-hashed build assets: cache for a year.
    location /_next/static/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_web;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Service worker must always revalidate so new deploys take effect.
    location ~ ^/(sw\.js|swe-worker.*\.js|manifest\.webmanifest)$ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_web;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Pages, server actions, RSC payloads. Server actions can stream, so keep
    # buffering off and allow slower agent-backed responses.
    location / {
        limit_req zone=mesh_general burst=100 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://mesh_web;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
