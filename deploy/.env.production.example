# Sayabot production environment. The easy way: run ./deploy/install.sh, which asks a few
# questions and writes deploy/.env.production for you. Or copy this file there (chmod 600).
# Never commit the real file. Back it up somewhere safe: losing SAYABOT_KEK makes every
# stored provider key, webhook secret and MCP header unrecoverable.

# ── Public hostname (DNS A/AAAA record must point at this VPS) ────────────
# Primary: SAYABOT_DOMAIN (legacy fallback: MESH_DOMAIN)
SAYABOT_DOMAIN=sayabot.example.com
# Let's Encrypt account / expiry notices
LETSENCRYPT_EMAIL=ops@example.com

# ── This server ──────────────────────────────────────────────────────────
# self-hosted (default): no plans, limits or billing. cloud: Sayabot Cloud only (see
# docs/sayabot-cloud.md); the ee/ billing code is commercially licensed.
SAYABOT_EDITION=self-hosted
# The name the Mac and phone apps show when they connect ("Acme's Sayabot").
SAYABOT_INSTANCE_NAME=Sayabot

# ── Optional: Cloudflare Tunnel instead of open ports + Let's Encrypt ────
# Zero Trust → Networks → Tunnels → Create (cloudflared) → copy the token. Then add a Public
# Hostname: SAYABOT_DOMAIN → HTTP → nginx:8080. When set, deploy.sh publishes no ports, skips
# init-letsencrypt.sh and runs cloudflared. Close 80/443 afterwards: sudo ufw delete allow 80/tcp ...
# If you put Cloudflare Access (SSO) in front, add a Bypass policy for the machine paths, which
# phones, the desktop app, bots, MCP clients and webhooks call without a browser:
#   /api/v1/*  /mcp/*  /oauth/*  /.well-known/*  /api/mobile/*  /api/desktop/*  /api/remote/*
#   /api/messaging/*  /api/version  /api/health
CLOUDFLARE_TUNNEL_TOKEN=

# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_COLLAB_URL are derived from SAYABOT_DOMAIN in
# docker-compose.yml, and ORCHESTRATOR_URL points at the internal service. Don't set them.

# ── Supabase ──────────────────────────────────────────────────────────────
# bundled: Supabase runs on this server too (docker-compose.supabase.yml); install.sh
#          generates everything below, with NEXT_PUBLIC_SUPABASE_URL=https://SAYABOT_DOMAIN.
# hosted:  your own supabase.com project (Project Settings → API / Database).
SAYABOT_SUPABASE=hosted
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler (port 5432). NOT the transaction pooler (6543): pg-boss, advisory
# locks and LISTEN/NOTIFY need session connections.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Bundled Supabase only (install.sh generates these; keep them with your backups):
# POSTGRES_PASSWORD=          # all Supabase database roles
# JWT_SECRET=                 # signs sign-in tokens and the two keys below (40+ chars)
# ANON_KEY=                   # = NEXT_PUBLIC_SUPABASE_ANON_KEY
# SERVICE_ROLE_KEY=           # = SUPABASE_SERVICE_ROLE_KEY
# SECRET_KEY_BASE=            # realtime (64 chars)
# REALTIME_DB_ENC_KEY=        # realtime (exactly 16 chars)
# Optional, bundled: email sending and "Sign in with Google/GitHub"
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_ADMIN_EMAIL= SMTP_SENDER_NAME=Sayabot
# SUPABASE_EMAIL_AUTOCONFIRM=false          # once SMTP works, require email confirmation
# SUPABASE_GOOGLE_ENABLED=true SUPABASE_GOOGLE_CLIENT_ID= SUPABASE_GOOGLE_SECRET=
# SUPABASE_GITHUB_ENABLED=true SUPABASE_GITHUB_CLIENT_ID= SUPABASE_GITHUB_SECRET=
#   (OAuth callback URL to register: https://SAYABOT_DOMAIN/auth/v1/callback)

# ── Secrets (generate once, keep stable) ─────────────────────────────────
# openssl rand -base64 32
# Primary: SAYABOT_KEK (legacy fallback: MESH_KEK)
SAYABOT_KEK=
# openssl rand -hex 32
ORCHESTRATOR_INTERNAL_SECRET=

# ── Login methods (also enable the provider in Supabase Auth) ────────────
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_SSO_ENABLED=false
GOOGLE_AUTH_ENABLED=false
GITHUB_AUTH_ENABLED=false
SSO_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Saya AI: your own provider, offered to every user with no key needed ─
# Shows up as "Saya AI" in the model picker (web, Mac app) and on phones. Agents store only an
# alias (saya/pro), so you can change the endpoint, key or the real model behind an alias here and
# every agent follows on its next turn. Nobody re-picks a model, and no app update is needed.
# Apply edits with: ./deploy/deploy.sh reload   (no rebuild; `restart` would keep the old values)
SAYA_AI_NAME=Saya AI
# Any OpenAI-compatible /v1 endpoint (vLLM, LiteLLM, OpenRouter, Together, Ollama...), or set
# SAYA_AI_PROTOCOL=openai / anthropic for those APIs directly.
SAYA_AI_BASE_URL=
SAYA_AI_API_KEY=
SAYA_AI_PROTOCOL=openai-compatible
# alias=real-model-id|Label, comma separated. Keep aliases stable; change the ids freely.
# Removing an alias moves its agents to SAYA_AI_DEFAULT instead of breaking them.
# e.g. SAYA_AI_MODELS=pro=gpt-5.1|Saya Pro,fast=gpt-5.1-mini|Saya Fast
SAYA_AI_MODELS=
# Used by "Automatic" and new agents (default: the first model)
SAYA_AI_DEFAULT=
# Background work: titles, memory, summaries, critics (default: "fast" if listed, else the default)
SAYA_AI_FAST=
# Older single shared model. Still works and becomes Saya AI's only model when SAYA_AI_BASE_URL is empty.
DEV_OPENAI_COMPAT_BASE_URL=
DEV_OPENAI_COMPAT_API_KEY=
DEV_OPENAI_COMPAT_MODEL=

# ── Optional tools ───────────────────────────────────────────────────────
E2B_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Agent computers (computerd) ──────────────────────────────────────────
# auto picks: smolvm (microVM, needs KVM or Apple silicon) → docker → e2b (cloud).
# On a Linux server, run deploy/scripts/setup-computers.sh to prepare the host.
COMPUTER_BACKEND=auto
# docker backend: runc, runsc (gVisor; no KVM needed) or auto
COMPUTER_DOCKER_RUNTIME=runc
# How many computers may run at once ("auto" = from host memory) and when idle ones sleep.
COMPUTER_MAX_RUNNING=auto
COMPUTER_IDLE_MS=600000
COMPUTER_MEM_MB=1024
# smolvm backend: registry ref or `docker save` tarball of the computer image
SMOLVM_IMAGE=
# e2b backend (cloud computers, for hosts without the resources to run them): uses E2B_API_KEY
E2B_TEMPLATE=base
E2B_MAX_RUNNING=20

# ── Optional: push alerts (npx web-push generate-vapid-keys) ─────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ── Tuning (optional) ────────────────────────────────────────────────────
# Image name prefix. Set to e.g. ghcr.io/you/sayabot to push/pull from a registry.
# Primary: SAYABOT_IMAGE_PREFIX (legacy fallback: MESH_IMAGE_PREFIX)
SAYABOT_IMAGE_PREFIX=sayabot
# Primary: SAYABOT_WEB_MEMORY (legacy fallback: MESH_WEB_MEMORY)
SAYABOT_WEB_MEMORY=1g
# Primary: SAYABOT_ORCHESTRATOR_MEMORY (legacy fallback: MESH_ORCHESTRATOR_MEMORY)
SAYABOT_ORCHESTRATOR_MEMORY=1g
# How many previous releases to keep for rollback
# Primary: SAYABOT_KEEP_RELEASES (legacy fallback: MESH_KEEP_RELEASES)
SAYABOT_KEEP_RELEASES=3
# Services to build and deploy: default is "orchestrator web" (or include "computerd egress")
# Primary: SAYABOT_APP_SERVICES (legacy fallback: MESH_APP_SERVICES)
SAYABOT_APP_SERVICES="orchestrator web"

# ── Sayabot Cloud billing (SAYABOT_EDITION=cloud only) ───────────────────
# Stripe: Developers → API keys; Product catalog → a monthly price per paid plan; Developers →
# Webhooks → https://SAYABOT_DOMAIN/api/billing/webhook (checkout.session.completed,
# customer.subscription.created/updated/deleted). See docs/sayabot-cloud.md.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=
