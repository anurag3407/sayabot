# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string (port 5432), used by Drizzle, pg-boss and LISTEN/NOTIFY.
# Do not use the transaction pooler (6543) for this service.
DATABASE_URL=

# Sayabot
# openssl rand -base64 32
SAYABOT_KEK=
# Legacy alias: MESH_KEK is also accepted
MESH_KEK=
# openssl rand -hex 32
ORCHESTRATOR_INTERNAL_SECRET=
ORCHESTRATOR_URL=http://localhost:4000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000/collab
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login methods (also enable the provider in Supabase Auth)
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=true
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SAML SSO is a Supabase Pro feature; this only exposes the admin toggle
NEXT_PUBLIC_SSO_ENABLED=false

# Saya AI: the server's own provider, shown to every user with no key (see docs/self-hosted-flow.md).
# Agents store an alias, so changing the ids here reaches them all after a restart.
# e.g. SAYA_AI_MODELS=pro=gpt-5.1|Saya Pro,fast=gpt-5.1-mini|Saya Fast
SAYA_AI_NAME=Saya AI
SAYA_AI_BASE_URL=
SAYA_AI_API_KEY=
SAYA_AI_PROTOCOL=openai-compatible
SAYA_AI_MODELS=
SAYA_AI_DEFAULT=
SAYA_AI_FAST=

# Older single fallback model (OpenAI-compatible endpoint, for example Ollama, vLLM or LM Studio).
# Used as Saya AI's only model when SAYA_AI_BASE_URL is empty.
DEV_OPENAI_COMPAT_BASE_URL=
DEV_OPENAI_COMPAT_API_KEY=
DEV_OPENAI_COMPAT_MODEL=

# Optional tools
E2B_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Agent computers (computerd) ──────────────────────────────────────────
# auto picks: smolvm (microVM, needs KVM or Apple silicon) → docker → e2b (cloud).
# On a Linux server, run deploy/scripts/setup-computers.sh to prepare the host.
COMPUTER_BACKEND=auto
# docker backend: runc, runsc (gVisor; no KVM needed) or auto
COMPUTER_DOCKER_RUNTIME=runc
# How many computers may run at once ("auto" = from host memory) and when idle ones sleep.
COMPUTER_MAX_RUNNING=auto
COMPUTER_IDLE_MS=600000
COMPUTER_MEM_MB=1024
# smolvm backend: registry ref or `docker save` tarball of the computer image
SMOLVM_IMAGE=
# e2b backend (cloud computers, for hosts without the resources to run them): uses E2B_API_KEY
E2B_TEMPLATE=base
E2B_MAX_RUNNING=20

# Cloudflare Ecosystem Integration (Workers AI, AI Gateway, Browser Rendering, R2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_BROWSER_RENDERING_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Optional: alerts when no tab is open. Generate a pair with `npx web-push generate-vapid-keys`.
# The subject is a mailto: or https: address push services can use to reach you.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Allow webhooks to private/loopback addresses (local bot development only)
SAYABOT_ALLOW_PRIVATE_WEBHOOKS=false
# Legacy alias: MESH_ALLOW_PRIVATE_WEBHOOKS is also accepted
MESH_ALLOW_PRIVATE_WEBHOOKS=false

# End-to-end tests (Playwright). Use two existing or disposable accounts in the same Supabase project.
E2E_BASE_URL=http://localhost:3000
E2E_ORG_SLUG=sayabot-e2e
E2E_USER_A_EMAIL=
E2E_USER_B_EMAIL=

# Usage page: read Claude Code / Codex / Antigravity logs from this machine's home folder.
# Auto-on only when Sayabot is opened on localhost. Never set to 1 on a shared server.
# SAYABOT_LOCAL_USAGE_SCAN=
